TMDB_API_KEY=colle_ta_cle_ici
PORT=3000

# Optionnel : catégorie Jeux vidéo (IGDB via Twitch Developer Console, gratuit)
# https://dev.twitch.tv -> créer une appli -> Client ID + Client Secret
# Sans ces deux variables, le serveur démarre quand même, juste sans les jeux.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Optionnel : catégorie Pays (photos via Pexels, gratuit, clé instantanée)
# https://www.pexels.com/api/ -> créer un compte -> clé API
# Sans cette variable, le serveur démarre quand même, juste sans les pays.
PEXELS_API_KEY=
